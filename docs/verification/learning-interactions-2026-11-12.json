    {
      "name": "machine-learning",
      "revision": 11,
      "sourceSHA256": "fa900a08f826c7a86907076d049a76b206f23eaa6313f55e1158680de2216869",
      "artifactSHA256": "d7110aee934e61120dd8eeab314e2b393c2593200ec0de8678d3e370bac42611",
      "rulesSHA256": "b41bd310a0ea3a3f763221e917230b5d5aaadd30ec3044d3da792801b4514942",
      "chapters": [
        {
          "chapterId": "ml-ch-data",
          "writing": "开篇直接说明参数、损失和优化，房价情境与无量纲教学数据分别交代。",
          "teaching": "侧栏补特征向量和预测时点，旧的参数锚点已更新。",
          "facts": "核对 A/B/C 的输入 1/2/3 与标签 2/4/5；未将房价单位套入无量纲数据。",
          "brief": "按具备一次函数基础的读者组织机制讲解。"
        },
        {
          "chapterId": "ml-ch-model",
          "writing": "删去重复的算术问句，以误差方向、汇总和尺度说明补充正文。",
          "teaching": "叠加粗体与颜色突出线性回归、特征、标签、均方误差；异常值解释独立成框。新增斜率/截距原生控件、观察点与实时 MSE；浏览器验证调参、重置和键盘不会翻页。",
          "facts": "核算 ŷ=x+1 的误差 0/−1/−1、MSE=2/3；+2/−2 的 MSE=4；所有公式经 KaTeX 解析。本轮独立核算初始 w=1,b=1 时 MSE=2/3；w=1.5,b=2/3 时 MSE=1/18，合法输入按 0.1 步长取值。",
          "brief": "保留参数含义与残差图示，图像和侧栏关联已在浏览器逐页检查。"
        },
        {
          "chapterId": "ml-ch-train",
          "writing": "更新说明围绕导数、步长与损失变化展开，删去正文复述式侧栏。",
          "teaching": "增加连续更新的损失曲线；侧栏补第二次更新和临界步长。",
          "facts": "J=2.5(w−2)²，η=.1 时 1→1.5→1.75→1.875；损失依次 2.5/.625/.15625/.0390625；收缩条件 0<η<.4。",
          "brief": "提供推导和核算，保留固定 b=0 的条件。"
        },
        {
          "chapterId": "ml-ch-evaluate",
          "writing": "以候选方案选择解释验证偏差，泛化定义采用直接表述。",
          "teaching": "增加 L2 参数收缩与两特征内积的具体计算，避免术语罗列。",
          "facts": "L2 目标导数为 5(w−2)+2λw，λ=.5 时 w=5/3；两特征预测 3×2−1×1+4=9。",
          "brief": "用患者分组和时间拆分说明评估设计，保留真实任务中的输入时点要求。"
        }
      ],
