    {
      "name": "machine-learning",
      "revision": 13,
      "sourceSHA256": "a5ee00680d7b59f3281375a3f0f9f2bca8f3af5e2866aaff87ccec145e59bddf",
      "rulesSHA256": "b41bd310a0ea3a3f763221e917230b5d5aaadd30ec3044d3da792801b4514942",
      "chapters": [
        {
          "chapterId": "ml-ch-data",
          "writing": "开篇直接说明参数、损失和优化，房价情境与无量纲教学数据分别交代。",
          "teaching": "侧栏补特征向量和预测时点，旧的参数锚点已更新。",
          "facts": "核对 A/B/C 的输入 1/2/3 与标签 2/4/5；未将房价单位套入无量纲数据。",
          "brief": "按具备一次函数基础的读者组织机制讲解。"
        },
        {
          "chapterId": "ml-ch-model",
          "writing": "拟合正文沿用原有模型说明，新增练习直接给出数据、模型与单位换算；题面不预先标记答案。",
          "teaching": "参数、曲线与右栏的 MSE/RMSE/R²同步变化；逐点误差可展开，残差在图中标示；计算拟合参数使用最小二乘。新增两题可从习题菜单定位、作答。",
          "facts": "独立核算初始残差 0/−1/−1，MSE=2/3；OLS 为 w=1.5、b=2/3，MSE=1/18；显示 b=0.667 时 MSE 四位小数为 0.0556。练习 w=1.5、b=.5 的 MSE=1/12；元换万元后 MSE/RMSE 分别缩小 10⁸/10⁴ 倍。",
          "brief": "保留线性模型机制讲解；指标与图形同源，先手动调参再比较解析解。"
        },
        {
          "chapterId": "ml-ch-train",
          "writing": "梯度更新围绕导数、步长与实际损失展开；新增图内说明直接写损失数值与缩小比例，保持原有标题和正文。",
          "teaching": "连续更新曲线补充 2.5→0.625→0.15625→0.0390625 与“每次更新 × 1/4”；圈注和引线联系第一次更新后的点。侧栏保留第二次更新与临界步长。",
          "facts": "核对原数据与 J=2.5(w−2)²，固定 b=0、η=0.1，从 w=1 出发得到 1.5、1.75、1.875；损失依次 2.5、0.625、0.15625、0.0390625，相邻项比值均为 1/4。图内数值与原曲线数据一致；收缩条件仍为 0<η<0.4。",
          "brief": "保留有一次函数基础的机制讲解；图内标注用于联系参数误差减半与平方损失缩小至四分之一。"
        },
        {
          "chapterId": "ml-ch-evaluate",
          "writing": "以候选方案选择解释验证偏差，泛化定义采用直接表述。",
          "teaching": "增加 L2 参数收缩与两特征内积的具体计算，避免术语罗列。",
          "facts": "L2 目标导数为 5(w−2)+2λw，λ=.5 时 w=5/3；两特征预测 3×2−1×1+4=9。",
          "brief": "用患者分组和时间拆分说明评估设计，保留真实任务中的输入时点要求。"
        }
      ],
