{
  "name": "paper-notebook-kit",
  "version": "2.7.1",
  "private": false,
  "type": "module",
  "description": "Create illustrated study notes with AI, annotate text and figures, practise and review.",
  "license": "MIT",
  "bin": {
    "paper-notebook": "tools/notebook.mjs",
    "paper-notebook-install-skill": "tools/install-skill.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:reader": "node tools/sync-prompts.mjs && node tools/build-validator.mjs && tsc --noEmit && vite build",
    "build": "npm run build:reader && node --import tsx tools/release.mjs",
    "build:pages": "npm run build:reader -- --mode pages && node --import tsx tools/release.mjs --pages && node tools/prepare-pages.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "notebook": "node tools/notebook.mjs",
    "install-skill": "node tools/install-skill.mjs",
    "test": "node tools/build-validator.mjs --check && node --import tsx --test tests/*.test.ts",
    "check:writing": "node tools/writing-check.mjs",
    "test:reader": "node tests/reader-browser.mjs",
    "test:hosting": "node tests/hosting-browser.mjs",
    "test:film": "node tests/film-buffering-browser.mjs && node tests/film-controls-browser.mjs",
    "test:showcase": "node tests/showcase-browser.mjs",
    "test:ui": "node tests/prescription-ui-browser.mjs",
    "test:details": "node tests/product-detail-browser.mjs",
    "test:runtime": "node tests/runtime-browser.mjs",
    "test:experience": "node tests/experience-browser.mjs",
    "test:workspace": "node tests/workspace-browser.mjs",
    "test:layout": "node tests/reading-layout-browser.mjs",
    "test:responsive": "node tests/responsive-figures-browser.mjs",
    "test:quality": "node tests/quality-browser.mjs",
    "benchmark:reader": "node tools/benchmark-reader.mjs",
    "test:iteration": "node tests/site-iteration-browser.mjs && node tests/controls-iteration-browser.mjs && node tests/figure-iteration-browser.mjs && node tests/state-iteration-browser.mjs",
    "test:content": "node tests/content-quality-browser.mjs",
    "test:exploration": "node tests/exploration-browser.mjs",
    "test:loading": "node tests/loading-browser.mjs",
    "test:overflow": "node tests/overflow-browser.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "fflate": "^0.8.2",
    "html-to-image": "^1.11.13",
    "katex": "^0.16.22",
    "markdown-it": "^14.1.0",
    "perfect-freehand": "^1.2.2",
    "roughjs": "^4.6.6",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/markdown-it": "^14.1.2",
    "@types/three": "^0.180.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vite-plugin-singlefile": "^2.3.0",
    "esbuild": "^0.28.2"
  }
}
