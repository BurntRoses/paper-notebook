{
  "name": "paper-notebook-kit",
  "version": "2.2.1",
  "private": false,
  "type": "module",
  "description": "A structured tutorial reader and a self-contained Skill for your own agent.",
  "license": "MIT",
  "bin": {
    "paper-notebook": "tools/notebook.mjs",
    "paper-notebook-install-skill": "tools/install-skill.mjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node tools/sync-prompts.mjs && tsc --noEmit && vite build && node --import tsx tools/release.mjs",
    "build:pages": "npm run build && node tools/prepare-pages.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "notebook": "node tools/notebook.mjs",
    "install-skill": "node tools/install-skill.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "check:writing": "node tools/writing-check.mjs",
    "test:reader": "node tests/reader-browser.mjs",
    "test:hosting": "node tests/hosting-browser.mjs",
    "test:experience": "node tests/experience-browser.mjs",
    "test:workspace": "node tests/workspace-browser.mjs",
    "test:quality": "node tests/quality-browser.mjs",
    "benchmark:reader": "node tools/benchmark-reader.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "fflate": "^0.8.2",
    "html-to-image": "^1.11.13",
    "katex": "^0.16.22",
    "markdown-it": "^14.1.0",
    "perfect-freehand": "^1.2.2",
    "roughjs": "^4.6.6",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/markdown-it": "^14.1.2",
    "@types/three": "^0.180.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vite-plugin-singlefile": "^2.3.0",
    "esbuild": "^0.28.2"
  }
}
