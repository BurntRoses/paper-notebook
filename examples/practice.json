{
  "schemaVersion": "1.0.0",
  "notebook": {
    "id": "notebook-observe-plant",
    "revision": 7,
    "title": "植物观察记录",
    "author": "Paper Notebook",
    "language": "zh-CN",
    "goals": [
      "用可比较的方式记录观察",
      "区分观察与原因解释"
    ],
    "sources": [
      {
        "id": "source-editorial",
        "title": "本项目编写的教学示例",
        "status": "illustrative"
      }
    ],
    "chapters": [
      {
        "id": "notebook-observe-plant-chapter",
        "title": "植物观察记录",
        "pages": [
          {
            "id": "plant-1",
            "title": "建立一次观察记录",
            "layout": "cornell",
            "blocks": [
              {
                "id": "plant-intro",
                "type": "prose",
                "text": "一次植物观察记录包括叶片的位置、颜色变化、盆土干湿、最近一次浇水日期。用相同角度的照片和具体日期连续记录，可以对照变化的方向与速度。逐次记录同一叶片的位置与颜色，再结合环境与养护信息分析原因。",
                "study": {
                  "marks": [
                    {
                      "text": "同一叶片的位置与颜色",
                      "kind": "underline"
                    },
                    {
                      "text": "盆土干湿",
                      "kind": "bold"
                    },
                    {
                      "text": "最近一次浇水日期",
                      "kind": "red",
                      "color": "#285f9e"
                    }
                  ]
                }
              },
              {
                "id": "plant-figure",
                "type": "image",
                "assetId": "plant-observation",
                "alt": "固定角度的盆栽观察示意，圈出下部两片黄色叶片，标注叶片位置、颜色、浇水日期和盆土干湿记录。",
                "caption": "先定位同一批叶片，再记录各次观察的颜色、数量和养护操作。圈注用于保持观察位置一致。",
                "figure": {
                  "size": "wide",
                  "ratio": "auto",
                  "annotations": [
                    {
                      "kind": "text",
                      "x": 6,
                      "y": 14,
                      "text": "连续观察同一位置",
                      "color": "#b1483d"
                    }
                  ]
                }
              },
              {
                "id": "plant-steps",
                "type": "steps",
                "items": [
                  {
                    "id": "plant-s1",
                    "text": "拍一张固定角度的照片，记下日期。"
                  },
                  {
                    "id": "plant-s2",
                    "text": "标明叶片位置，记录颜色、数量以及是否下垂。"
                  },
                  {
                    "id": "plant-s3",
                    "text": "按该植物适合的方法检查盆土干湿，不只看表面颜色。"
                  },
                  {
                    "id": "plant-s4",
                    "text": "写下今天采取的操作，过几天在同一角度比较。"
                  }
                ]
              },
              {
                "id": "plant-warn",
                "type": "callout",
                "tone": "warning",
                "text": "植物种类及条件影响水分需求：叶片、根系和盆土共同影响吸水与失水。记录时加入植物名称、盆器排水和最近的浇水情况，再结合该种植物的养护资料分析变化。",
                "study": {
                  "marks": [
                    {
                      "text": "植物种类及条件",
                      "kind": "dots"
                    }
                  ]
                }
              },
              {
                "id": "plant-log",
                "type": "comparison",
                "columns": [
                  "日期",
                  "观察到的现象",
                  "采取的操作"
                ],
                "rows": [
                  [
                    "今天",
                    "下部两片叶子变黄",
                    "记录照片，核对养护条件"
                  ],
                  [
                    "三天后",
                    "由你补充",
                    "由你补充"
                  ]
                ]
              }
            ],
            "cues": [
              {
                "id": "cue-observe",
                "title": "连续记录",
                "text": "同一角度保留可比较的位置与尺度，具体日期提供时间间隔，便于判断叶片变化的速度。",
                "blockId": "plant-intro",
                "anchor": "相同角度的照片和具体日期"
              },
              {
                "id": "cue-condition",
                "title": "吸水与失水",
                "text": "叶片蒸腾、根系吸收与盆土含水共同影响植株水分状态。结合这些记录，才能解释同样的叶片下垂。",
                "blockId": "plant-warn",
                "anchor": "吸水与失水"
              }
            ]
          },
          {
            "id": "plant-2",
            "title": "观察与原因解释",
            "layout": "reading",
            "blocks": [
              {
                "id": "plant-concept",
                "type": "concept",
                "title": "叶片变化与原因判断",
                "text": "“两片老叶变黄”记录可见变化。原因判断还需要植物种类、浇水和根系状态等证据：叶片位置反映变化范围，浇水记录提供时间线，根系与盆土状态帮助判断吸水条件。每项记录都应对应一项可以复查的现象。",
                "study": {
                  "marks": [
                    {
                      "text": "原因判断",
                      "kind": "circle"
                    },
                    {
                      "text": "原因判断",
                      "kind": "bold"
                    },
                    {
                      "text": "原因判断",
                      "kind": "red",
                      "color": "#285f9e"
                    },
                    {
                      "text": "还需要植物种类、浇水和根系状态等证据",
                      "kind": "underline"
                    }
                  ]
                }
              },
              {
                "id": "plant-match",
                "type": "exercise",
                "questionType": "matching",
                "question": "每条记录属于哪种类别？",
                "pairs": [
                  {
                    "id": "plant-p1",
                    "left": "照片里有两片黄叶",
                    "right": "观察"
                  },
                  {
                    "id": "plant-p2",
                    "left": "可能是光照不足",
                    "right": "待核实的解释"
                  },
                  {
                    "id": "plant-p3",
                    "left": "明天核对养护资料",
                    "right": "后续行动"
                  }
                ],
                "explanation": "分别记录观察现象、待核实原因和后续行动，复查时更容易判断。",
                "points": 3
              },
              {
                "id": "plant-reflect",
                "type": "exercise",
                "questionType": "subjective",
                "question": "为你身边的一盆植物写一条记录。",
                "explanation": "参考要点：包含日期、具体观察、已知条件；将原因判断写成待核实的假设。",
                "points": 0
              }
            ]
          }
        ]
      }
    ]
  },
