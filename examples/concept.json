                      "x": 67,
                      "y": 77,
                      "text": "按编号去重",
                      "color": "#285f9e"
                    }
                  ]
                },
                "caption": "三条交易记录共享一个顾客编号：交易计三次，顾客计一次。"
              },
              {
                "id": "obs-key",
                "type": "callout",
                "tone": "note",
                "text": "订单数是 3，顾客数是 1，总金额为145元。每单平均金额为145÷3≈48.33元；每位顾客累计购买145元。分母决定指标含义。",
                "study": {
                  "marks": [
                    {
                      "text": "分母决定指标含义",
                      "kind": "bold"
                    },
                    {
                      "text": "分母决定指标含义",
                      "kind": "red",
                      "color": "#285f9e"
                    }
                  ]
                }
              },
              {
                "id": "obs-question",
                "type": "prose",
                "text": "月度活跃顾客可定义为当月至少有一笔已付款且未退款订单的顾客。本月120人、上月100人时，增长率为(120−100)÷100=20%。相同的时间跨度与筛选条件，使两个数值具有可比性。"
              }
            ],
            "cues": [
              {
                "id": "obs-denominator-note",
                "title": "分母与指标",
                "text": "同一笔 145 元销售额，除以订单数得到每单金额，除以人数得到每位顾客的购买额。分母改变，指标回答的问题也随之改变。",
                "blockId": "obs-key",
                "anchor": "分母决定指标含义"
              }
            ]
          },
          {
            "id": "observation-2",
            "title": "统计范围与筛选",
            "layout": "cornell",
            "blocks": [
              {
                "id": "obs-path",
                "type": "diagram",
                "title": "同一批筛选记录的两种计数",
                "nodes": [
                  {
                    "id": "raw",
                    "label": "订单表"
                  },
                  {
                    "id": "define",
                    "label": "指定月份、已付款、未退款"
                  },
                  {
                    "id": "count",
                    "label": "按订单行计数"
                  },
                  {
                    "id": "judge",
                    "label": "顾客编号去重后计数"
                  }
                ],
                "edges": [
                  {
                    "from": "raw",
                    "to": "define",
                    "label": "先筛选"
                  },
                  {
                    "from": "define",
                    "to": "count",
                    "label": "交易次数"
                  },
                  {
                    "from": "define",
                    "to": "judge",
                    "label": "购买人数"
                  }
                ],
                "figure": {
                  "size": "wide",
                  "ratio": "auto"
                }
              },
              {
                "id": "obs-steps",
                "type": "steps",
                "items": [
                  {
                    "id": "obs-step-1",
                    "text": "确定指标：本次统计已付款订单及对应的顾客人数。"
                  },
                  {
                    "id": "obs-step-2",
                    "text": "确定范围：只看本月、已付款、未退款的订单。"
                  },
                  {
                    "id": "obs-step-3",
                    "text": "按目标计数，再挑几行原始记录手工核对。"
                  }
                ],
                "study": {
                  "marks": [
                    {
                      "text": "本月、已付款、未退款",
                      "kind": "bold"
                    },
                    {
                      "text": "本月、已付款、未退款",
                      "kind": "red",
                      "color": "#b1483d"
                    }
                  ]
                }
              },
              {
                "id": "obs-example",
                "type": "example",
                "title": "五笔订单，三位顾客",
                "prompt": "顾客编号依次为 A、A、B、A、C。订单数和顾客数分别是多少？",
                "steps": [
                  {
                    "id": "obs-ex-1",
                    "text": "每行代表一笔订单，共 5 行。"
                  },
                  {
                    "id": "obs-ex-2",
                    "text": "按顾客去重，留下 A、B、C。"
                  }
                ],
                "result": "订单数 5，顾客数 3。再增加一笔 A 的订单，订单数变成 6，顾客数仍然是 3。"
              },
              {
                "id": "obs-boundary",
                "type": "callout",
                "title": "新增订单与新增顾客",
                "text": "原有顾客再下单，交易数增加而去重人数保持不变；新顾客首次下单，两项指标同时增加。订单增长可结合顾客增长和购买频次进一步分解。",
                "study": {
                  "marks": [
                    {
                      "text": "购买频次",
                      "kind": "bold"
                    },
                    {
                      "text": "交易数增加而去重人数保持不变",
                      "kind": "red",
                      "color": "#285f9e"
                    }
                  ]
                }
              }
            ],
            "cues": [
              {
                "id": "cue-grain",
                "title": "购买频次",
                "text": "订单数除以去重人数，得到每位顾客的平均订单数。五笔订单、三位顾客，对应约 1.67 笔/人。",
                "blockId": "obs-example",
                "anchor": "订单数 5，顾客数 3"
              },
              {
                "id": "cue-range",
                "title": "筛选顺序",
                "text": "先筛选本月已付款、未退款的记录，再对其中的顾客编号去重，才能得到这组条件下的人数。",
                "blockId": "obs-steps",
                "anchor": "只看本月、已付款、未退款的订单"
              }
            ]
          },
          {
            "id": "observation-3",
            "title": "名单合并与去重",
            "layout": "grid",
            "blocks": [
              {
                "id": "obs-overlap",
                "type": "prose",
                "text": "上海的顾客编号为 A、B、C、D，杭州为 C、D、E。两地分别有 4 人和 3 人，C、D 在两地都出现。合并的是名单，去重之后才是全体人数，本例共 5 人。",
                "study": {
                  "marks": [
                    {
                      "text": "合并的是名单，去重之后才是全体人数",
                      "kind": "bold"
                    },
                    {
                      "text": "合并的是名单，去重之后才是全体人数",
                      "kind": "red",
                      "color": "#285f9e"
                    }
                  ]
                }
              },
              {
                "id": "obs-union-figure",
                "type": "image",
                "assetId": "customer-overlap",
                "alt": "上海四位顾客A、B、C、D，杭州三位C、D、E，两位重复；合并去重后五人。",
                "caption": "交集 C、D 在两份名单中各出现一次。相加后减去一次交集人数，得到 4+3−2=5。",
                "figure": {
                  "size": "wide",
                  "ratio": "auto"
                }
              },
              {
                "id": "obs-formula",
                "type": "formula",
                "latex": "|A \\cup B| = |A| + |B| - |A \\cap B|",
                "text": "A 和 B 是两组顾客。交集表示两边都出现过的人；这些人需要减去一次。",
                "study": {
                  "marks": [
                    {
                      "text": "减去一次",
                      "kind": "dots"
                    },
                    {
                      "text": "交集",
                      "kind": "bold"
                    },
                    {
                      "text": "交集",
                      "kind": "red",
                      "color": "#285f9e"
                    }
                  ]
                }
              },
              {
                "id": "obs-sql",
                "type": "code",
                "title": "统计十月已付款且未退款的订单",
                "language": "sql",
                "text": "SELECT COUNT(*) AS orders,\n       COUNT(DISTINCT customer_id) AS customers\nFROM orders\nWHERE paid_at >= '2026-10-01'\n  AND paid_at <  '2026-11-01'\n  AND status = 'paid'\n  AND refunded_at IS NULL;",
                "study": {
                  "explanations": [
                    {
                      "text": "COUNT(*)",
                      "note": "对筛选后的每行计数，得到订单数。"
                    },
                    {
                      "text": "COUNT(DISTINCT customer_id)",
                      "note": "顾客编号去重后计数；NULL 不参与这一计数。"
                    },
                    {
                      "text": "refunded_at IS NULL",
                      "note": "退款时间为空，表示该记录没有退款事件。"
                    }
                  ]
                },
                "sourceRefs": [
                  {
                    "sourceId": "postgres-count",
                    "locator": "count(*) 与 count(DISTINCT expression)"
                  }
                ]
              },
              {
                "id": "obs-sql-fields",
                "type": "callout",
                "title": "时间区间与缺失编号",
                "text": "本例 orders 表包含付款时间 paid_at、付款状态 status、退款时间 refunded_at 和顾客编号 customer_id。时间条件包含十月一日零点，排除十一月一日零点；付款时间按同一业务时区解释。顾客编号为空的订单仍计入订单数，人数统计前应核查这些缺失记录。"
              },
              {
                "id": "obs-checks",
                "type": "checklist",
                "title": "本次统计口径",
                "items": [
                  {
                    "id": "obs-check-1",
                    "text": "每行代表一笔已付款订单。"
                  },
                  {
                    "id": "obs-check-2",
                    "text": "跨城市顾客按统一编号合并去重。"
                  },
                  {
                    "id": "obs-check-3",
                    "text": "月度范围与退款筛选条件保持一致。"
                  }
                ]
              }
            ],
            "cues": [
              {
                "id": "obs-union-note",
                "title": "重复计数",
                "text": "同时在两座城市购买的顾客，在两份名单中各出现一次；相加后减去交集人数，就能使每人只计一次。",
                "blockId": "obs-formula",
                "anchor": "交集"
              }
            ]
