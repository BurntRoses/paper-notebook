        "pages": [
          {
            "id": "observation-1",
            "title": "订单数与顾客数",
            "layout": "reading",
            "blocks": [
              {
                "id": "obs-opening",
                "type": "prose",
                "text": "书店的订单表记录每笔交易的订单号、顾客编号和金额。顾客编号连接同一人的多笔购买。同一位顾客可产生多笔订单，因此订单数与顾客数分别反映交易次数和购买人数。"
              },
              {
                "id": "obs-concept",
                "type": "concept",
                "title": "统计粒度",
                "text": "统计粒度是每条记录代表的对象，也是表格组织数据的基本单位。订单表以一笔交易为单位，同一顾客可占多行；顾客表以一位顾客为单位，同一编号占一行。从订单数转为顾客数，需要先按顾客编号去重。",
                "study": {
                  "marks": [
                    {
                      "text": "统计粒度",
                      "kind": "circle"
                    },
                    {
                      "text": "统计粒度",
                      "kind": "bold"
                    },
                    {
                      "text": "统计粒度",
                      "kind": "red",
                      "color": "#285f9e"
                    },
                    {
                      "text": "每条记录代表的对象",
                      "kind": "underline"
                    }
                  ]
                }
              },
              {
                "id": "obs-table",
                "type": "comparison",
                "title": "三笔订单",
                "columns": [
                  "订单",
                  "顾客",
                  "金额"
                ],
                "rows": [
                  [
                    "01",
                    "小林",
                    "¥ 38"
                  ],
                  [
                    "02",
                    "小林",
                    "¥ 62"
                  ],
                  [
                    "03",
                    "小林",
                    "¥ 45"
                  ]
                ]
              },
              {
                "id": "obs-customer-map",
                "type": "diagram",
                "title": "三笔订单指向同一顾客",
                "nodes": [
                  {
                    "id": "obs-order-01",
                    "label": "订单 01：38 元"
                  },
                  {
                    "id": "obs-order-02",
                    "label": "订单 02：62 元"
                  },
                  {
                    "id": "obs-order-03",
                    "label": "订单 03：45 元"
                  },
                  {
