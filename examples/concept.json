    "language": "zh-CN",
    "goals": [
      "区分订单数与顾客数",
      "识别分组之间的重复",
      "在解释数字前写清统计口径"
    ],
    "sources": [
      {
        "id": "source-editorial",
        "title": "本项目编写的教学示例",
        "status": "illustrative"
      },
      {
        "id": "postgres-count",
        "title": "PostgreSQL · Aggregate Functions",
        "url": "https://www.postgresql.org/docs/current/functions-aggregate.html"
      }
    ],
    "chapters": [
      {
        "id": "notebook-observation-chapter",
        "title": "从问题到理解",
        "pages": [
          {
            "id": "observation-1",
            "title": "订单数与顾客数",
            "subtitle": "记录的对象决定统计结果。",
            "layout": "reading",
            "blocks": [
              {
                "id": "obs-opening",
                "type": "prose",
                "text": "一个人，在书店下了三次单。订单表里有三行记录，但背后只有一位读者。问“卖出了几单”和问“有几位顾客”，答案自然不同。"
              },
              {
                "id": "obs-concept",
                "type": "concept",
                "title": "统计粒度",
                "text": "统计粒度，是每一条记录所代表的对象。先明确对象，再计数。三笔订单，可能来自一位顾客，也可能来自三位顾客。",
                "study": {
                  "marks": [
                    {
                      "text": "统计粒度",
                      "kind": "circle"
                    },
                    {
                      "text": "统计粒度",
                      "kind": "bold"
                    },
                    {
                      "text": "统计粒度",
                      "kind": "red",
                      "color": "#285f9e"
                    }
                  ]
                }
              },
              {
                "id": "obs-table",
                "type": "comparison",
                "title": "三笔订单",
                "columns": [
                  "订单",
                  "顾客",
                  "金额"
                ],
                "rows": [
                  [
                    "01",
                    "小林",
                    "¥ 38"
                  ],
                  [
                    "02",
                    "小林",
                    "¥ 62"
                  ],
                  [
                    "03",
                    "小林",
                    "¥ 45"
                  ]
                ]
              },
              {
                "id": "obs-key",
                "type": "callout",
                "tone": "note",
                "text": "订单数是 3，顾客数是 1。数字没有互相矛盾，它们回答了两个问题。",
                "study": {
                  "marks": [
                    {
                      "text": "订单数是 3，顾客数是 1",
                      "kind": "check"
                    }
                  ]
                }
              },
              {
                "id": "obs-question",
                "type": "prose",
                "text": "下次见到“用户增长了 20%”，先问一句：用户指注册用户、活跃用户，还是付费用户？时间范围是什么？比较对象一致吗？"
              }
            ]
          },
          {
            "id": "observation-2",
            "title": "从材料到判断",
            "subtitle": "每一步都需要明确的输入和检查。",
            "layout": "cornell",
            "blocks": [
              {
                "id": "obs-path",
                "type": "diagram",
                "title": "从材料到判断",
                "nodes": [
                  {
                    "id": "raw",
                    "label": "原始材料"
                  },
                  {
                    "id": "define",
                    "label": "确定对象与范围"
                  },
                  {
                    "id": "count",
                    "label": "计算与核对"
                  },
                  {
                    "id": "judge",
                    "label": "解释结果"
                  }
                ],
                "edges": [
                  {
                    "from": "raw",
                    "to": "define"
                  },
                  {
                    "from": "define",
                    "to": "count"
                  },
                  {
                    "from": "count",
                    "to": "judge"
                  }
                ]
              },
              {
                "id": "obs-steps",
                "type": "steps",
                "items": [
                  {
                    "id": "obs-step-1",
                    "text": "先写下问题：这次想数订单，还是数人？"
                  },
                  {
                    "id": "obs-step-2",
                    "text": "确定范围：只看本月、已付款、未退款的订单。"
                  },
                  {
                    "id": "obs-step-3",
                    "text": "按目标计数，再挑几行原始记录手工核对。"
                  }
                ],
                "study": {
                  "marks": [
                    {
                      "text": "只看本月、已付款、未退款的订单",
                      "kind": "underline"
                    }
                  ]
                }
              },
              {
                "id": "obs-example",
                "type": "example",
                "title": "五笔订单，三位顾客",
                "prompt": "顾客编号依次为 A、A、B、A、C。订单数和顾客数分别是多少？",
                "steps": [
                  {
                    "id": "obs-ex-1",
                    "text": "每行代表一笔订单，共 5 行。"
                  },
                  {
                    "id": "obs-ex-2",
                    "text": "按顾客去重，留下 A、B、C。"
                  }
                ],
                "result": "订单数 5，顾客数 3。再增加一笔 A 的订单，订单数变成 6，顾客数仍然是 3。"
              },
              {
                "id": "obs-boundary",
                "type": "quote",
                "text": "解释数字前，先写清统计口径。",
                "attribution": "统计口径"
              }
            ],
            "cues": [
              {
                "id": "cue-grain",
                "text": "这次统计订单，还是顾客？",
                "blockId": "obs-steps",
                "anchor": "这次想数订单，还是数人"
              },
              {
                "id": "cue-range",
                "text": "哪些订单属于本次范围？",
                "blockId": "obs-steps",
                "anchor": "只看本月、已付款、未退款的订单"
              },
              {
                "id": "cue-count",
                "text": "再增加一笔 A 的订单，顾客数变吗？",
                "blockId": "obs-example",
                "anchor": "顾客数仍然是 3"
              }
            ],
            "summary": "回看时先回答两个问题：每行记录代表什么？哪些记录属于统计范围？口径确定之后，计算与解释才有共同的依据。"
          },
          {
            "id": "observation-3",
            "title": "名单合并与去重",
            "subtitle": "名单可能重叠，计数需要去重。",
            "layout": "grid",
            "blocks": [
              {
                "id": "obs-overlap",
                "type": "prose",
                "text": "同一个人，可能在上海和杭州都下过单。两座城市的顾客人数直接相加，就会数他两次。合并的是名单，去重之后才是全体人数。"
              },
              {
                "id": "obs-formula",
                "type": "formula",
                "latex": "|A \\cup B| = |A| + |B| - |A \\cap B|",
                "text": "A 和 B 是两组顾客。交集表示两边都出现过的人；这些人需要减去一次。",
                "study": {
                  "marks": [
                    {
                      "text": "减去一次",
                      "kind": "dots"
                    }
                  ]
                }
              },
              {
                "id": "obs-sql",
                "type": "code",
                "language": "sql",
                "text": "SELECT COUNT(*) AS orders,\n       COUNT(DISTINCT customer_id) AS customers\nFROM orders\nWHERE status = 'paid';",
                "sourceRefs": [
                  {
                    "sourceId": "postgres-count",
                    "locator": "count(*) 与 count(DISTINCT expression)"
                  }
                ]
              },
              {
                "id": "obs-checks",
                "type": "checklist",
                "title": "解释结果前，问自己",
                "items": [
                  {
                    "id": "obs-check-1",
                    "text": "我能说清每一行代表什么。"
                  },
                  {
                    "id": "obs-check-2",
                    "text": "不同分组之间，可能有重复的人。"
                  },
                  {
                    "id": "obs-check-3",
                    "text": "我核对过时间、对象与范围。"
                  }
                ]
              }
            ]
          },
          {
            "id": "observation-4",
            "title": "检验统计口径",
            "subtitle": "三道客观题，含解释与答案。",
            "layout": "exam",
            "blocks": [
              {
                "id": "obs-quiz-1",
                "type": "exercise",
                "questionType": "single",
                "question": "A、A、B、C、A 共五笔订单，涉及多少位顾客？",
                "options": [
                  {
                    "id": "obs-q1-a",
                    "text": "3 位"
                  },
                  {
                    "id": "obs-q1-b",
                    "text": "4 位"
                  },
                  {
                    "id": "obs-q1-c",
                    "text": "5 位"
                  }
                ],
                "solution": [
                  "obs-q1-a"
                ],
                "explanation": "去重后的顾客编号为 A、B、C，共 3 位。",
                "points": 2
              },
              {
                "id": "obs-quiz-2",
                "type": "exercise",
                "questionType": "multiple",
                "question": "比较两个统计结果，至少需要核对哪些条件？",
                "options": [
                  {
                    "id": "obs-q2-a",
                    "text": "计数对象"
                  },
                  {
                    "id": "obs-q2-b",
                    "text": "时间范围"
                  },
                  {
                    "id": "obs-q2-c",
                    "text": "筛选条件"
                  },
                  {
                    "id": "obs-q2-d",
                    "text": "图表的背景颜色"
                  }
                ],
                "solution": [
                  "obs-q2-a",
                  "obs-q2-b",
                  "obs-q2-c"
                ],
                "explanation": "对象、时间和筛选条件会改变结果。背景颜色不会改变统计口径。",
                "points": 3
              },
              {
                "id": "obs-quiz-3",
                "type": "exercise",
                "questionType": "truefalse",
                "question": "两个城市的顾客人数，可以始终直接相加得到总人数。",
                "options": [
                  {
                    "id": "obs-q3-t",
                    "text": "正确"
                  },
                  {
                    "id": "obs-q3-f",
                    "text": "错误"
                  }
                ],
                "solution": [
                  "obs-q3-f"
                ],
                "explanation": "同一位顾客可能在两个城市都出现，需要在合并后去重。",
                "points": 1
              }
            ]
          }
        ]
      }
    ]
