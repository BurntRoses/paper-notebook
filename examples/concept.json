    "chapters": [
      {
        "id": "notebook-observation-chapter",
        "title": "数字与证据",
        "pages": [
          {
            "id": "observation-1",
            "title": "订单数与顾客数",
            "layout": "reading",
            "blocks": [
              {
                "id": "obs-opening",
                "type": "prose",
                "text": "书店的订单表记录每笔交易的订单号、顾客编号和金额。顾客编号连接同一人的多笔购买。统计订单数与顾客数时，需要分别选择计数对象。"
              },
              {
                "id": "obs-concept",
                "type": "concept",
                "title": "统计粒度",
                "text": "统计粒度是每条记录代表的对象。订单表以一笔交易为单位，同一顾客可占多行；顾客表以一位顾客为单位，同一编号占一行。从订单数转为顾客数，需要先按顾客编号去重。",
                "study": {
                  "marks": [
                    {
                      "text": "统计粒度",
                      "kind": "circle"
                    },
                    {
                      "text": "统计粒度",
                      "kind": "bold"
                    },
                    {
                      "text": "统计粒度",
                      "kind": "red",
                      "color": "#285f9e"
                    },
                    {
                      "text": "每条记录代表的对象",
                      "kind": "underline"
                    }
                  ]
                }
              },
              {
                "id": "obs-table",
                "type": "comparison",
                "title": "三笔订单",
                "columns": [
                  "订单",
                  "顾客",
                  "金额"
                ],
                "rows": [
                  [
                    "01",
                    "小林",
                    "¥ 38"
                  ],
                  [
                    "02",
                    "小林",
                    "¥ 62"
                  ],
                  [
                    "03",
                    "小林",
                    "¥ 45"
                  ]
                ]
              },
              {
                "id": "obs-key",
                "type": "callout",
                "tone": "note",
                "text": "订单数是 3，顾客数是 1，总金额为145元。每单平均金额为145÷3≈48.33元；每位顾客累计购买145元。分母决定指标含义。",
                "study": {
                  "marks": [
                    {
                      "text": "分母决定指标含义",
                      "kind": "bold"
                    },
                    {
                      "text": "分母决定指标含义",
                      "kind": "red",
                      "color": "#285f9e"
                    }
                  ]
                }
              },
              {
                "id": "obs-question",
                "type": "prose",
                "text": "月度活跃顾客可定义为当月至少有一笔已付款且未退款订单的顾客。本月120人、上月100人时，增长率为(120−100)÷100=20%。相同的时间跨度与筛选条件，使两个数值具有可比性。"
              }
            ],
            "cues": [
              {
                "id": "obs-denominator-note",
                "title": "分母与指标",
                "text": "同一笔 145 元销售额，除以订单数得到每单金额，除以人数得到每位顾客的购买额。分母改变，指标回答的问题也随之改变。",
                "blockId": "obs-key",
                "anchor": "分母决定指标含义"
              }
            ]
          },
          {
            "id": "observation-2",
            "title": "统计范围与筛选",
            "layout": "cornell",
            "blocks": [
              {
                "id": "obs-path",
                "type": "diagram",
                "title": "统计范围与筛选",
                "nodes": [
                  {
                    "id": "raw",
                    "label": "原始材料"
                  },
                  {
                    "id": "define",
                    "label": "确定对象与范围"
                  },
                  {
                    "id": "count",
                    "label": "计算与核对"
                  },
                  {
                    "id": "judge",
                    "label": "解释结果"
                  }
                ],
                "edges": [
                  {
                    "from": "raw",
                    "to": "define"
                  },
                  {
                    "from": "define",
                    "to": "count"
                  },
                  {
                    "from": "count",
                    "to": "judge"
                  }
                ]
              },
              {
                "id": "obs-steps",
                "type": "steps",
                "items": [
                  {
                    "id": "obs-step-1",
                    "text": "确定指标：本次统计已付款订单及对应的顾客人数。"
                  },
                  {
                    "id": "obs-step-2",
                    "text": "确定范围：只看本月、已付款、未退款的订单。"
                  },
                  {
                    "id": "obs-step-3",
                    "text": "按目标计数，再挑几行原始记录手工核对。"
                  }
                ],
                "study": {
                  "marks": [
                    {
                      "text": "本月、已付款、未退款",
                      "kind": "bold"
                    },
                    {
                      "text": "本月、已付款、未退款",
                      "kind": "red",
                      "color": "#b1483d"
                    }
                  ]
                }
              },
              {
                "id": "obs-example",
                "type": "example",
                "title": "五笔订单，三位顾客",
                "prompt": "顾客编号依次为 A、A、B、A、C。订单数和顾客数分别是多少？",
                "steps": [
                  {
                    "id": "obs-ex-1",
                    "text": "每行代表一笔订单，共 5 行。"
                  },
                  {
                    "id": "obs-ex-2",
                    "text": "按顾客去重，留下 A、B、C。"
                  }
                ],
                "result": "订单数 5，顾客数 3。再增加一笔 A 的订单，订单数变成 6，顾客数仍然是 3。"
              },
              {
                "id": "obs-boundary",
                "type": "callout",
                "title": "新增订单与新增顾客",
                "text": "原有顾客再下单，交易数增加而去重人数保持不变；新顾客首次下单，两项指标同时增加。订单增长可结合顾客增长和购买频次进一步分解。",
                "study": {
                  "marks": [
                    {
                      "text": "购买频次",
                      "kind": "bold"
                    },
                    {
                      "text": "交易数增加而去重人数保持不变",
                      "kind": "red",
                      "color": "#285f9e"
                    }
                  ]
                }
              }
            ],
            "cues": [
              {
                "id": "cue-grain",
                "title": "购买频次",
                "text": "订单数除以去重人数，得到每位顾客的平均订单数。五笔订单、三位顾客，对应约 1.67 笔/人。",
                "blockId": "obs-example",
                "anchor": "订单数 5，顾客数 3"
              },
              {
                "id": "cue-range",
                "title": "筛选顺序",
                "text": "先筛选本月已付款、未退款的记录，再对其中的顾客编号去重，才能得到这组条件下的人数。",
                "blockId": "obs-steps",
                "anchor": "只看本月、已付款、未退款的订单"
              }
            ]
          },
          {
            "id": "observation-3",
            "title": "名单合并与去重",
            "layout": "grid",
            "blocks": [
              {
                "id": "obs-overlap",
                "type": "prose",
                "text": "同一个人，可能在上海和杭州都下过单。两座城市的顾客人数直接相加，就会数他两次。合并的是名单，去重之后才是全体人数。",
                "study": {
                  "marks": [
                    {
                      "text": "合并的是名单，去重之后才是全体人数",
                      "kind": "bold"
                    },
                    {
                      "text": "合并的是名单，去重之后才是全体人数",
                      "kind": "red",
                      "color": "#285f9e"
                    }
                  ]
                }
              },
              {
                "id": "obs-formula",
                "type": "formula",
                "latex": "|A \\cup B| = |A| + |B| - |A \\cap B|",
                "text": "A 和 B 是两组顾客。交集表示两边都出现过的人；这些人需要减去一次。",
                "study": {
                  "marks": [
                    {
                      "text": "减去一次",
                      "kind": "dots"
                    },
                    {
                      "text": "交集",
                      "kind": "bold"
                    },
                    {
                      "text": "交集",
                      "kind": "red",
                      "color": "#285f9e"
                    }
                  ]
                }
              },
              {
                "id": "obs-sql",
                "type": "code",
                "language": "sql",
                "text": "SELECT COUNT(*) AS orders,\n       COUNT(DISTINCT customer_id) AS customers\nFROM orders\nWHERE status = 'paid';",
                "sourceRefs": [
                  {
                    "sourceId": "postgres-count",
                    "locator": "count(*) 与 count(DISTINCT expression)"
                  }
                ]
              },
              {
                "id": "obs-checks",
                "type": "checklist",
                "title": "本次统计口径",
                "items": [
                  {
                    "id": "obs-check-1",
                    "text": "每行代表一笔已付款订单。"
                  },
                  {
                    "id": "obs-check-2",
                    "text": "跨城市顾客按统一编号合并去重。"
                  },
                  {
                    "id": "obs-check-3",
                    "text": "月度范围与退款筛选条件保持一致。"
                  }
                ]
              }
            ],
            "cues": [
              {
                "id": "obs-union-note",
                "title": "重复计数",
                "text": "同时在两座城市购买的顾客，在两份名单中各出现一次；相加后减去交集人数，就能使每人只计一次。",
                "blockId": "obs-formula",
                "anchor": "交集"
              }
            ]
          },
          {
            "id": "observation-4",
            "title": "检验统计口径",
            "layout": "exam",
            "blocks": [
              {
                "id": "obs-quiz-1",
                "type": "exercise",
                "questionType": "single",
                "question": "A、A、B、C、A 共五笔订单，涉及多少位顾客？",
                "options": [
                  {
                    "id": "obs-q1-a",
                    "text": "3 位"
                  },
                  {
                    "id": "obs-q1-b",
                    "text": "4 位"
                  },
                  {
                    "id": "obs-q1-c",
                    "text": "5 位"
                  }
                ],
                "solution": [
                  "obs-q1-a"
                ],
                "explanation": "去重后的顾客编号为 A、B、C，共 3 位。",
                "points": 2
              },
              {
                "id": "obs-quiz-2",
                "type": "exercise",
                "questionType": "multiple",
                "question": "比较两个统计结果，至少需要核对哪些条件？",
                "options": [
                  {
                    "id": "obs-q2-a",
                    "text": "计数对象"
                  },
                  {
                    "id": "obs-q2-b",
                    "text": "时间范围"
                  },
                  {
                    "id": "obs-q2-c",
                    "text": "筛选条件"
                  },
                  {
                    "id": "obs-q2-d",
                    "text": "图表的背景颜色"
                  }
                ],
                "solution": [
                  "obs-q2-a",
                  "obs-q2-b",
                  "obs-q2-c"
                ],
                "explanation": "对象、时间和筛选条件会改变结果。背景颜色不会改变统计口径。",
                "points": 3
              },
              {
                "id": "obs-quiz-3",
                "type": "exercise",
                "questionType": "truefalse",
                "question": "两个城市的顾客人数，可以始终直接相加得到总人数。",
                "options": [
                  {
                    "id": "obs-q3-t",
                    "text": "正确"
                  },
                  {
                    "id": "obs-q3-f",
                    "text": "错误"
                  }
                ],
                "solution": [
                  "obs-q3-f"
                ],
                "explanation": "同一位顾客可能在两个城市都出现，需要在合并后去重。",
                "points": 1
              }
            ]
          }
        ]
      }
    ]
