                    {
                      "text": "期末总值",
                      "kind": "star"
                    }
                  ]
                },
                "items": [
                  {
                    "id": "intro-review-1",
                    "text": "百分数转小数：5% 写成 0.05。"
                  },
                  {
                    "id": "intro-review-2",
                    "text": "确认复利次数：两期就是乘两次 1.05。"
                  },
                  {
                    "id": "intro-review-3",
                    "text": "区分期末总值与净增长：净增长还要减去本金。"
                  }
                ]
              },
              {
                "id": "intro-templates",
