                  "两期后的结果"
                ],
                "rows": [
                  [
                    "单利：始终是初始本金",
                    "100 + 10 + 10 = 120"
                  ],
                  [
                    "复利：上一期的期末值",
                    "100 × 1.1 × 1.1 = 121"
                  ]
                ]
              },
              {
                "id": "intro-area",
