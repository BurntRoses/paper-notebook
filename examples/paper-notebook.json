          {
            "id": "intro-principles",
            "title": "递推关系与复利通式",
            "subject": "stem",
            "layout": "cornell",
            "paper": {
              "ruling": "lined",
              "lineHeight": 34
            },
            "cues": [
              {
                "id": "intro-cue-condition",
                "text": "为什么乘 1 + r？",
                "blockId": "intro-native"
              },
              {
                "id": "intro-cue-formula",
                "text": "n 次相乘",
                "blockId": "intro-flow"
              },
              {
                "id": "intro-cue-check",
                "text": "用小数值核算",
                "blockId": "intro-anchor"
              }
            ],
            "summary": "下一期 = 本期 × (1 + r)。重复 n 期，所以 Pₙ = P₀(1 + r)ⁿ。",
            "blocks": [
              {
                "id": "intro-native",
                "type": "prose",
                "study": {
                  "tone": "blue",
                  "marks": [
                    {
                      "text": "本期的值 + 本期的增长",
                      "kind": "underline"
                    },
                    {
                      "text": "本期的值 × (1 + r)",
                      "kind": "bold"
                    },
                    {
                      "text": "本期的值 × (1 + r)",
                      "kind": "red",
                      "color": "#285f9e"
                    }
                  ]
                },
                "text": "下一期的值 = 本期的值 + 本期的增长 = 本期的值 × (1 + r)。"
              },
              {
                "id": "intro-flow",
                "type": "formula",
                "study": {
                  "visual": "blackboard",
                  "tone": "blue",
                  "marks": [
                    {
                      "text": "r：每期增长率",
                      "kind": "box"
                    }
                  ]
                },
                "latex": "P_n=P_0(1+r)^n",
                "text": "P₀：初始值；r：每期增长率；n：期数。"
              },
              {
                "id": "intro-anchor",
                "type": "example",
                "study": {
                  "tone": "olive",
                  "marks": [
                    {
                      "text": "期末 121 元",
                      "kind": "check"
                    }
                  ]
                },
                "prompt": "100 元，每期增长 10%，两期后：",
                "steps": [
                  {
                    "id": "intro-growth-1",
                    "text": "第一期：100 × 1.1 = 110。"
                  },
                  {
                    "id": "intro-growth-2",
                    "text": "第二期：110 × 1.1 = 121。"
                  }
                ],
                "result": "期末 121 元，累计增长 21 元。"
              }
            ]
          },
