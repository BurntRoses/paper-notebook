            "paper": {
              "ruling": "lined",
              "lineHeight": 34
            },
            "blocks": [
              {
                "id": "intro-lead",
                "type": "prose",
                "study": {
                  "label": "01 · 一句话定义",
                  "tone": "blue",
                  "marks": [
                    {
                      "text": "上一期的期末值",
                      "kind": "highlight"
                    }
                  ]
                },
                "text": "复利：每一期的增长，都以上一期的期末值为基础。新增的利息，也会参与下一期的增长。"
              },
              {
                "id": "intro-read",
                "type": "concept",
                "title": "这份模型的条件",
                "study": {
                  "tone": "red",
                  "explanations": [
                    {
                      "text": "增长率恒定",
                      "note": "每一期使用相同的 r。"
                    }
                  ],
                  "marks": [
                    {
                      "text": "增长率恒定",
                      "kind": "circle"
                    },
                    {
                      "text": "没有额外存取",
                      "kind": "wave"
                    }
                  ]
                },
                "text": "这里假设每期增长率恒定、利息计入本金，期间没有额外存取。期数与增长率必须使用同一时间单位。"
              },
              {
                "id": "intro-create",
                "type": "comparison",
                "study": {
                  "label": "02 · 放在一起比较",
                  "tone": "blue"
                },
                "columns": [
                  "每期增长的基础",
                  "两期后的结果"
                ],
                "rows": [
                  [
                    "单利：始终是初始本金",
                    "100 + 10 + 10 = 120"
                  ],
                  [
                    "复利：上一期的期末值",
                    "100 × 1.1 × 1.1 = 121"
                  ]
                ]
              },
              {
                "id": "intro-promise",
                "type": "callout",
                "study": {
                  "label": "多出的 1 元从哪里来",
                  "visual": "extract",
                  "tone": "red",
                  "marks": [
                    {
                      "text": "第二期多出的 1 元",
                      "kind": "bracket"
                    }
                  ]
                },
                "text": "第二期多出的 1 元，来自第一期 10 元利息的再次增长：10 × 10% = 1。"
              }
            ]
          },
          {
            "id": "intro-principles",
            "title": "每一期，都乘一次 1 + r",
            "subtitle": "复利笔记 02 / 递推 → 通式 → 核算",
            "subject": "stem",
            "layout": "cornell",
            "paper": {
              "ruling": "lined",
              "lineHeight": 34
            },
            "cues": [
              {
                "id": "intro-cue-condition",
                "text": "为什么乘 1 + r？",
                "blockId": "intro-native"
              },
              {
                "id": "intro-cue-formula",
                "text": "n 次相乘",
                "blockId": "intro-flow"
              },
              {
                "id": "intro-cue-check",
                "text": "用小数值核算",
                "blockId": "intro-anchor"
              }
            ],
            "summary": "下一期 = 本期 × (1 + r)。重复 n 期，所以 Pₙ = P₀(1 + r)ⁿ。",
            "blocks": [
              {
                "id": "intro-native",
                "type": "prose",
                "study": {
                  "label": "01 · 从一期开始",
                  "tone": "blue",
                  "marks": [
                    {
                      "text": "本期的值 + 本期的增长",
                      "kind": "underline"
                    }
                  ]
                },
                "text": "下一期的值 = 本期的值 + 本期的增长 = 本期的值 × (1 + r)。"
              },
              {
                "id": "intro-flow",
                "type": "formula",
                "study": {
                  "label": "02 · 敲黑板：n 次相乘",
                  "visual": "blackboard",
                  "tone": "blue",
                  "marks": [
                    {
                      "text": "r：每期增长率",
                      "kind": "box"
                    }
                  ]
                },
                "latex": "P_n=P_0(1+r)^n",
                "text": "P₀：初始值；r：每期增长率；n：期数。"
              },
              {
                "id": "intro-anchor",
                "type": "example",
                "study": {
                  "label": "03 · 代入核算",
                  "tone": "olive",
                  "marks": [
                    {
                      "text": "期末 121 元",
                      "kind": "check"
                    }
                  ]
                },
                "prompt": "100 元，每期增长 10%，两期后：",
                "steps": [
                  {
                    "id": "intro-growth-1",
                    "text": "第一期：100 × 1.1 = 110。"
                  },
                  {
                    "id": "intro-growth-2",
                    "text": "第二期：110 × 1.1 = 121。"
                  }
                ],
                "result": "期末 121 元，累计增长 21 元。"
              }
            ]
          },
          {
            "id": "intro-features",
