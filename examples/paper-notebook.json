                "questionType": "single",
                "question": "初始值 200，每期增长 5%，两期后是多少？",
                "options": [
                  {
                    "id": "intro-answer-a",
                    "text": "210"
                  },
                  {
                    "id": "intro-answer-b",
                    "text": "220"
                  },
                  {
                    "id": "intro-answer-c",
                    "text": "220.5"
                  }
                ],
                "solution": [
                  "intro-answer-c"
                ],
                "explanation": "200 × 1.05² = 220.5。第二期以 210 为基础，增长 10.5。",
                "points": 1
              },
              {
                "id": "intro-owned",
                "type": "prose",
                "study": {
                  "tone": "red",
                  "marks": [
                    {
                      "text": "220 是单利结果",
                      "kind": "wave"
                    }
                  ]
                },
                "text": "220 是单利结果；复利结果多出的 0.5，来自第一期利息的再次增长。"
              }
            ]
