    "title": "复利的递推关系",
    "subtitle": "用一个具体数值，理解指数与复利。",
    "author": "Paper Notebook",
    "language": "zh-CN",
    "goals": [
      "从递推关系推出指数形式",
      "检查公式的前提条件"
    ],
    "sources": [
      {
        "id": "source-editorial",
        "title": "本项目编写的教学示例",
        "status": "illustrative"
      }
