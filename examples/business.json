            "cues": [
              {
                "id": "business-retention-note",
                "title": "续费率的口径",
                "text": "美国与加拿大、全球两个口径覆盖的市场范围不同。比较续费率时，应沿用同一地域口径。",
                "blockId": "business-case-table",
                "anchor": "美国/加拿大 92.3%"
              }
            ],
            "blocks": [
              {
                "id": "business-case-facts",
                "type": "prose",
                "text": "Costco 以会员仓储零售经营：有限品类集中采购，低价吸引购买，高销量和快速周转配合高效配送，支持较低商品毛利下的经营。会员费随会员资格按期收取，续费率反映已有会员继续付费的比例。商品销售的规模、周转效率与会员关系共同支撑经营。\n\n下表采用截至 2025 年 8 月 31 日的财年数据，金额均为美元。",
                "sourceRefs": [
                  {
                    "sourceId": "business-costco",
                    "locator": "2025 Annual Report, pp. 4, 24–25"
                  }
                ],
                "study": {
                  "marks": [
