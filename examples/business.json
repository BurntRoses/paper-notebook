              {
                "id": "business-cue-sides",
                "text": "盈亏平衡点两侧的利润如何变化？",
                "blockId": "business-table"
              }
            ],
            "blocks": [
              {
                "id": "business-conditions",
                "type": "prose",
                "text": "教学模型设定：单价 80 元，单位变动成本 50 元，固定成本 3000 元。单件销售先贡献 30 元覆盖固定成本，超过 100 件后才形成正利润。",
                "study": {
                  "label": "给定条件",
                  "marks": [
                    {
                      "text": "单位变动成本 50 元",
                      "kind": "underline"
                    },
                    {
                      "text": "固定成本 3000 元",
                      "kind": "bold"
                    },
                    {
                      "text": "超过 100 件后才形成正利润",
                      "kind": "red",
                      "color": "#b1483d"
                    },
                    {
                      "text": "固定成本 3000 元",
                      "kind": "red",
                      "color": "#285f9e"
                    }
                  ]
                }
              },
              {
                "id": "business-formula",
                "type": "formula",
                "latex": "Q_{BE}=\\frac{F}{p-v}=\\frac{3000}{80-50}=100",
                "text": "单位贡献为 30 元；100 件贡献 3000 元，恰好覆盖固定成本。",
                "study": {
                  "label": "盈亏平衡销量",
                  "visual": "blackboard",
                  "marks": [
                    {
                      "text": "单位贡献为 30 元",
                      "kind": "box"
                    }
                  ]
                }
              },
              {
                "id": "business-breakeven-chart",
                "type": "chart",
                "title": "收入与总成本",
