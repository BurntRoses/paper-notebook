                    "label": "收入 80Q",
                    "points": [
                      {
                        "x": 0,
                        "y": 0
                      },
                      {
                        "x": 80,
                        "y": 6400
                      },
                      {
                        "x": 100,
                        "y": 8000
                      },
                      {
                        "x": 120,
                        "y": 9600
                      }
                    ]
                  },
                  {
                    "id": "business-cost",
                    "label": "总成本 3000+50Q",
                    "points": [
                      {
                        "x": 0,
                        "y": 3000
