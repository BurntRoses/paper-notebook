                ],
                "caption": "教学模型；两条线在销量 100 件、金额 8000 元处相交，此时利润为 0。",
                "figure": {
                  "size": "wide",
                  "ratio": "auto",
                  "style": "sketch",
                  "annotations": [
                    {
                      "kind": "circle",
                      "x": 74,
                      "y": 21,
