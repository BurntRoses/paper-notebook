                "id": "structure-formula",
                "type": "formula",
                "latex": "P_n=P_0(1+r)^n",
                "text": "每期金额 = 上一期金额 × (1 + r)。",
                "study": {
                  "visual": "blackboard",
                  "label": "02 · 敲黑板",
                  "marks": [
                    {
                      "text": "上一期金额",
                      "kind": "box"
