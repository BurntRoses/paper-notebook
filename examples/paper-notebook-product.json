              },
              {
                "id": "structure-example",
                "type": "example",
                "prompt": "100 元，每期增长 10%，共两期。",
                "steps": [
                  {
                    "id": "structure-e1",
                    "text": "100 × 1.1 = 110"
                  },
                  {
                    "id": "structure-e2",
                    "text": "110 × 1.1 = 121"
                  }
