              {
                "id": "literature-reading",
                "type": "prose",
                "text": "首联以“国”“城”起句，视野由山河收向都城，忧国之情寄寓在所望的景物中。草木的繁盛反衬城市的荒芜，景与情由此交织；“望”既是眼前的观看，也成为全诗情感展开的起点。",
                "study": {
                  "marks": [
                    {
                      "text": "繁盛反衬城市的荒芜",
                      "kind": "circle"
                    },
                    {
                      "text": "忧国之情寄寓在所望的景物中",
                      "kind": "highlight"
                    }
                  ]
                }
              }
            ]
          },
          {
            "id": "subject-literature-context",
            "title": "战乱中的杜甫与全诗结构",
            "subject": "literature",
            "layout": "cornell",
            "cues": [
              {
                "id": "literature-context-cue",
                "text": "诗作于怎样的处境？",
                "blockId": "literature-context"
              },
              {
                "id": "literature-structure-cue",
                "text": "全诗怎样由景入情？",
                "blockId": "literature-structure"
              }
            ],
            "summary": "“望”统摄全诗：前四句写所见，后四句转入战事、家书与白发；家国之忧和离别之情在同一视线中展开。",
            "blocks": [
              {
                "id": "literature-context",
                "type": "prose",
                "text": "安史之乱中，长安于756年六月失守。杜甫安顿家人后前往投奔肃宗，途中被叛军带回长安，《春望》写于次年三月。诗人身陷沦陷的都城，与家人音信隔绝。战乱、隔绝和人事凋残，使眼前春景处处牵动忧思。",
                "sourceRefs": [
                  {
                    "sourceId": "source-spring-commentary",
                    "locator": "写作背景与全诗赏析"
                  }
                ],
                "study": {
                  "marks": [
                    {
                      "text": "次年三月",
                      "kind": "circle"
                    },
                    {
                      "text": "战乱、隔绝和人事凋残",
                      "kind": "bold"
                    },
                    {
                      "text": "战乱、隔绝和人事凋残",
                      "kind": "red",
                      "color": "#b1483d"
                    }
                  ]
                }
              },
              {
