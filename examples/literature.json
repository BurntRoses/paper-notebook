                    "label": "山河、草木：所见"
                  },
                  {
                    "id": "context",
                    "label": "国破、城春：语境"
                  },
                  {
                    "id": "reading",
                    "label": "恒常景物衬出人事凋零"
                  }
                ],
                "edges": [
                  {
                    "from": "scene",
