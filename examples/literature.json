                  }
                ],
                "caption": "景物的存在、城市的处境和诗人的感受沿着“望”字相连。",
                "study": {
                  "visual": "sketch"
                },
                "figure": {
                  "size": "wide",
                  "ratio": "auto",
                  "style": "sketch",
                  "annotations": [
                    {
                      "kind": "circle",
