            "cues": [
              {
                "id": "code-id-note",
                "title": "编号与人数",
                "text": "只有编号与顾客一一对应，编号去重数才等于人数。跨门店编号不一致时，需要先统一映射。",
                "blockId": "code-limit",
                "anchor": "统一编号映射"
              }
            ],
            "blocks": [
              {
                "id": "code-question",
                "type": "prose",
                "text": "A、A、B 是三条记录，包含两个不同的顾客编号。集合保留不同的值。",
                "study": {
                  "label": "问题与数据",
                  "marks": [
                    {
                      "text": "集合保留不同的值",
                      "kind": "bold"
                    },
                    {
                      "text": "集合保留不同的值",
                      "kind": "red",
                      "color": "#285f9e"
                    }
                  ]
                }
              },
              {
                "id": "code-example",
                "type": "code",
                "language": "Python",
                "text": "def count_customers(ids):\n    unique_ids = set(ids)\n    return len(unique_ids)\nids = [\"A\", \"A\", \"B\"]\nprint(count_customers(ids))  # 2",
                "study": {
                  "explanations": [
                    {
                      "text": "set",
                      "note": "将列表转为集合，重复的字符串 A 只保留一个，得到 {\"A\", \"B\"}。"
                    },
                    {
                      "text": "len",
                      "note": "返回集合中的元素个数，结果为整数 2。"
                    }
                  ]
                }
              },
              {
                "id": "code-map",
                "type": "diagram",
                "nodes": [
                  {
                    "id": "records",
                    "label": "列表 [A, A, B]"
                  },
                  {
                    "id": "distinct",
                    "label": "集合 {A, B}"
                  },
                  {
                    "id": "count",
                    "label": "长度 2"
                  }
                ],
                "edges": [
                  {
                    "from": "records",
                    "to": "distinct",
                    "label": "set"
                  },
                  {
                    "from": "distinct",
                    "to": "count",
                    "label": "len"
                  }
                ],
                "study": {
                  "visual": "sketch"
                },
                "figure": {
