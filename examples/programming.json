            "blocks": [
              {
                "id": "code-practice-state",
                "type": "exercise",
                "questionType": "single",
                "question": "records = [\"A\", \"A\", \"B\"]。程序依次执行 seen.add(customer)，第二次 add 执行结束后，seen 的内容是什么？",
                "options": [
                  {
                    "id": "code-practice-state-a",
                    "text": "{\"A\"}"
                  },
                  {
                    "id": "code-practice-state-b",
                    "text": "[\"A\", \"A\"]"
                  },
                  {
                    "id": "code-practice-state-c",
                    "text": "{\"A\", \"B\"}"
                  }
                ],
                "solution": [
                  "code-practice-state-a"
                ],
                "explanation": "前两条记录都是 A。集合保留互不相等的元素，因此第二次 add 后仍为 {\"A\"}。第三条记录 B 加入后，集合才变为 {\"A\", \"B\"}。",
                "points": 1
              }
            ]
