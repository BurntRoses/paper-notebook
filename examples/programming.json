                    {
                      "text": "{A, B}",
                      "kind": "circle"
                    }
                  ]
                }
              },
              {
                "id": "code-state",
                "type": "prose",
                "text": "set() 创建一个新的集合，原列表保持不变。集合按元素是否相等决定是否保留。第二次加入 A 时，已有集合包含 A，大小保持为 1；加入 B 时出现一个新值，大小增为 2。set(ids) 一次完成这个去重过程，len 再读取结果的元素数。",
                "study": {
                  "marks": [
                    {
                      "text": "大小保持为 1",
                      "kind": "underline"
                    },
                    {
                      "text": "大小增为 2",
                      "kind": "dots"
                    }
                  ]
                }
              },
              {
                "id": "code-tests",
                "type": "code",
                "language": "Python",
                "text": "assert count_customers([]) == 0\nassert count_customers([\"A\"]) == 1\nassert count_customers([\"A\", \"A\"]) == 1\nassert count_customers([\"A\", \"B\"]) == 2",
                "study": {
                  "explanations": [
                    {
                      "text": "[]",
                      "note": "空列表生成空集合，长度为 0。"
                    },
                    {
                      "text": "assert",
                      "note": "条件为真时继续运行；为假时抛出 AssertionError。"
                    }
                  ]
                }
              },
              {
                "id": "code-contract",
                "type": "callout",
                "title": "编号的数据形式",
                "text": "本例的顾客编号使用字符串。字符串可以作为集合元素；若记录是字典，则提取其中的 customer_id 字段后再去重。列表保留记录顺序，集合用于成员判定与去重，遍历集合时不依赖元素的排列顺序。先在同一解释器执行前页的函数定义，再运行本页断言。",
                "study": {
                  "marks": [
                    {
                      "text": "字符串",
                      "kind": "bold"
                    },
                    {
                      "text": "成员判定与去重",
                      "kind": "check"
                    }
                  ]
                }
              }
            ]
