                    "1"
                  ],
                  [
                    "A",
                    "{A}",
                    "1"
                  ],
                  [
                    "B",
                    "{A, B}",
                    "2"
                  ]
                ],
                "study": {
                  "marks": [
                    {
                      "text": "已出现的编号集合",
                      "kind": "bold"
                    },
