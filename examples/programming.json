            "subject": "code",
            "layout": "reading",
            "blocks": [
              {
                "id": "code-question",
                "type": "prose",
                "text": "A、A、B 是三条记录，包含两个不同的顾客编号。集合保留不同的值。",
                "study": {
                  "label": "问题与数据",
                  "marks": [
                    {
                      "text": "不同的顾客编号",
                      "kind": "circle"
                    },
                    {
                      "text": "不同的顾客编号",
                      "kind": "bold"
                    },
                    {
                      "text": "不同的顾客编号",
                      "kind": "red",
                      "color": "#285f9e"
                    }
                  ]
                }
              },
              {
                "id": "code-example",
                "type": "code",
                "language": "Python",
                "text": "def count_customers(ids):\n    unique_ids = set(ids)\n    return len(unique_ids)\nids = [\"A\", \"A\", \"B\"]\nprint(count_customers(ids))  # 2",
                "study": {
                  "explanations": [
                    {
                      "text": "set",
                      "note": "同值去重，得到 {A, B}。"
                    },
                    {
                      "text": "len",
                      "note": "求集合长度，结果为 2。"
                    }
                  ]
                }
              },
              {
                "id": "code-map",
                "type": "diagram",
                "nodes": [
                  {
                    "id": "records",
                    "label": "列表 [A, A, B]"
                  },
                  {
                    "id": "distinct",
                    "label": "集合 {A, B}"
                  },
                  {
                    "id": "count",
                    "label": "长度 2"
                  }
                ],
                "edges": [
                  {
                    "from": "records",
                    "to": "distinct",
                    "label": "set"
                  },
                  {
                    "from": "distinct",
                    "to": "count",
                    "label": "len"
                  }
                ],
                "study": {
                  "visual": "sketch"
                },
                "figure": {
                  "size": "wide",
                  "ratio": "auto",
                  "style": "sketch",
                  "annotations": [
                    {
                      "kind": "circle",
                      "x": 32,
                      "y": 80,
                      "x2": 68,
                      "y2": 94,
                      "color": "#285f9e"
                    }
                  ]
                }
              },
              {
                "id": "code-limit",
                "type": "prose",
                "text": "顾客数的统计依赖稳定的顾客编号。跨门店合并记录时，先统一编号映射，再对编号去重；同一人的多条订单才会归入同一个集合元素。",
                "study": {
                  "label": "统计口径",
                  "visual": "extract",
                  "marks": [
                    {
                      "text": "稳定的顾客编号",
                      "kind": "star"
                    }
                  ]
                }
              }
            ]
          },
          {
            "id": "subject-code-trace",
            "title": "集合的状态与函数测试",
            "subject": "code",
            "layout": "cornell",
            "cues": [
              {
                "id": "code-trace-cue",
                "text": "第二个 A 到来后，集合怎样变化？",
                "blockId": "code-trace"
              },
              {
                "id": "code-empty-cue",
                "text": "空列表为什么得到 0？",
                "blockId": "code-tests"
              }
            ],
            "blocks": [
              {
                "id": "code-trace",
                "type": "comparison",
                "title": "逐条加入编号",
                "columns": [
                  "读入的编号",
                  "已出现的编号集合",
                  "集合长度"
                ],
                "rows": [
                  [
                    "A",
